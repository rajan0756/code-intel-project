# ── Which AI provider to use ──────────────────────────────────────────────────
# Options: groq | gemini | watsonx
# Start with "groq" — free, no credit card, sign up at console.groq.com
PROVIDER=groq

# ── Groq (free) ───────────────────────────────────────────────────────────────
# Sign up: https://console.groq.com → API Keys → Create key
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (free tier) ─────────────────────────────────────────────────
# Sign up: https://aistudio.google.com → Get API key
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-1.5-flash

# ── IBM watsonx.ai (hackathon credentials) ────────────────────────────────────
WATSONX_API_KEY=REPLACE_WITH_YOUR_IBM_CLOUD_API_KEY
WATSONX_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
WATSONX_REGION=us-south
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Local testing ─────────────────────────────────────────────────────────────
# Set to 1 to use mock responses (no API calls at all)
USE_MOCK=1
